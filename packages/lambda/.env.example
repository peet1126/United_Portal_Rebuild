# Copy this to .env for local development against a local MySQL instance.
# DB_PROXY_ENDPOINT must be UNSET (or absent) to trigger local mode in connection.ts.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=united_portal
DB_USER=root
DB_PASSWORD=your_local_password

# Set to true to auto-create tables on first run (dev only — never in production).
DB_SYNC=true
